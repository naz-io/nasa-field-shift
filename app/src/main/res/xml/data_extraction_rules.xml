<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-to-device transfer rules for Android 12+ (API 31+).
   Keep only the saved field (DataStore file), so a new phone opens on the farmer's field.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/field.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/field.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
