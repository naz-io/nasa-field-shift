<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 6–11 (API 23–30). Android 12+ uses data_extraction_rules.xml.
   Only the farmer's saved field is worth keeping; map tiles and other caches can be re-downloaded.
   Once an <include> is present, nothing else is backed up.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="file" path="datastore/field.preferences_pb" />
</full-backup-content>
